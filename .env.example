# ==============================================================================
# AI Language Translation Tool - Environment Configuration
# ==============================================================================

# Translation Provider Options: 'google' (Google Cloud Translation v2), 'microsoft' (Azure Translator), or 'mymemory' (Free demo)
TRANSLATION_PROVIDER=google

# Your Translation API Key (required for Google Cloud or Microsoft Azure Translator)
TRANSLATION_API_KEY=your_api_key_here

# Optional: Custom endpoint URL override (defaults to official API URL if blank)
TRANSLATION_API_URL="https://translation.googleapis.com/language/translate/v2"

# Microsoft Azure Translator Region (e.g., global, eastus, westeurope)
TRANSLATION_API_REGION=global

# Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Automatic fallback to free public translation service if TRANSLATION_API_KEY is not configured
# Allows immediate local testing and evaluation out of the box
ENABLE_DEMO_FALLBACK=True

# Gemini API Key (Optional for Android / AI Studio integration)
# GEMINI_API_KEY=

